{
  "name": "@pap/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev:local": "tsx watch src/dev/local.ts",
    "seed": "tsx --env-file-if-exists=.env src/dev/seed.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "@hono/zod-validator": "^0.9.1",
    "@pap/db": "workspace:*",
    "@pap/shared": "workspace:*",
    "@supabase/supabase-js": "^2.119.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.18",
    "jose": "^6.2.17",
    "node-cron": "^4.6.0",
    "postgres": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/node": "^22",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
