# Copie para apps/api/.env e preencha. Nada daqui vai para o navegador.

NODE_ENV=development
PORT=8787

# Supabase > Connect > "Session pooler" (porta 5432). Troque [YOUR-PASSWORD].
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Supabase > Project Settings > Data API > Project URL
SUPABASE_URL=https://xxxxxxxx.supabase.co

# Supabase > Project Settings > API Keys > Secret key (sb_secret_...). SEGREDO.
SUPABASE_SECRET_KEY=

# Endereços do site que podem chamar a API (separados por vírgula).
WEB_ORIGINS=http://localhost:3000

# Google Cloud > Credenciais > Chave de API, restrita à Places API (New). SEGREDO.
# Opcional: sem ela a busca de restaurantes usa só o OpenStreetMap.
GOOGLE_PLACES_API_KEY=

# Buckets do Storage (criados sozinhos na primeira subida da API).
MEDIA_BUCKET=media
BACKUP_BUCKET=backups

# Liga o ping diário e o backup semanal. Use "true" só na Railway.
CRON_ENABLED=false
