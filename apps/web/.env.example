# Copie para apps/web/.env.local e preencha.
# Tudo que começa com NEXT_PUBLIC_ vai para o navegador: aqui só entra o que é público.

# Endereço da API do PAP (apps/api). Em produção, o domínio da Railway.
NEXT_PUBLIC_API_URL=http://localhost:8787

# Supabase > Project Settings > Data API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co

# Supabase > Project Settings > API Keys > Publishable key (sb_publishable_...).
# É uma chave pública por natureza; a chave secreta fica só em apps/api.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
